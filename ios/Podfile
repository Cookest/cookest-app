# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Create symlink for build/ios to bypass iCloud sync issues
  build_ios_dir = File.expand_path(File.join('..', '..', 'build', 'ios'), __FILE__)
  cache_dir = '/Users/exxo/Library/Caches/cookest-ui-build/ios'
  
  if File.exist?(build_ios_dir) && !File.symlink?(build_ios_dir)
    require 'fileutils'
    FileUtils.rm_rf(build_ios_dir)
  end
  
  require 'fileutils'
  build_dir = File.dirname(build_ios_dir)
  FileUtils.mkdir_p(build_dir)
  FileUtils.mkdir_p(cache_dir)
  
  unless File.symlink?(build_ios_dir)
    File.symlink(cache_dir, build_ios_dir)
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # Inject codesign attributes cleanup for Pod targets to bypass iCloud sync metadata issues
    if target.respond_to?(:new_shell_script_build_phase)
      phase_name = 'Clear codesign attributes'
      script_content = 'if [ -n "$CODESIGNING_FOLDER_PATH" ] && [ -d "$CODESIGNING_FOLDER_PATH" ]; then find "$CODESIGNING_FOLDER_PATH" -exec xattr -d com.apple.FinderInfo {} \; 2>/dev/null; find "$CODESIGNING_FOLDER_PATH" -exec xattr -d com.apple.ResourceFork {} \; 2>/dev/null; find "$CODESIGNING_FOLDER_PATH" -exec xattr -d "com.apple.fileprovider.fpfs#P" {} \; 2>/dev/null; fi'
      existing_phase = target.shell_script_build_phases.find { |p| p.name == phase_name }
      if existing_phase
        existing_phase.shell_script = script_content
      else
        phase = target.new_shell_script_build_phase(phase_name)
        phase.shell_script = script_content
      end
    end
  end

  # Inject a Build Phase at the end of the Runner target to strip extended attributes before signing
  require 'xcodeproj'
  project_path = File.join(File.dirname(__FILE__), 'Runner.xcodeproj')
  project = Xcodeproj::Project.open(project_path)
  runner_target = project.targets.find { |t| t.name == 'Runner' }
  if runner_target
    phase_name = 'Clear codesign attributes'
    script_content = 'if [ -n "$CODESIGNING_FOLDER_PATH" ] && [ -d "$CODESIGNING_FOLDER_PATH" ]; then find "$CODESIGNING_FOLDER_PATH" -exec xattr -d com.apple.FinderInfo {} \; 2>/dev/null; find "$CODESIGNING_FOLDER_PATH" -exec xattr -d com.apple.ResourceFork {} \; 2>/dev/null; find "$CODESIGNING_FOLDER_PATH" -exec xattr -d "com.apple.fileprovider.fpfs#P" {} \; 2>/dev/null; fi'
    existing_phase = runner_target.shell_script_build_phases.find { |p| p.name == phase_name }
    if existing_phase
      existing_phase.shell_script = script_content
      project.save
    else
      phase = runner_target.new_shell_script_build_phase(phase_name)
      phase.shell_script = script_content
      project.save
    end
  end
end
